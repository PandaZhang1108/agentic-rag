# ==============================================================================
# 复制成 .env 后填写：  cp .env.example .env
# .env 已经在 .gitignore / .dockerignore 里，不会被提交、也不会进镜像。
# ==============================================================================

# ---- 必填 ----
POSTGRES_PASSWORD=改成一个强密码
POSTGRES_URL=postgresql://postgres:改成一个强密码@localhost:5432/ragdb
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
# 调用 /chat 时前端要在 X-API-Key 头里带上这个值。
# 生成一个随机的：  python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY=dev-local-key

# ---- RAG 参数（改了 CHUNK_* 之后必须 python ingest.py --rebuild）----
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVE_K=5
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=fastapi_docs_hybrid
MILVUS_SEARCH_MODE=dense
MILVUS_CANDIDATE_K=10
MILVUS_RRF_K=60
# 本项目资料是 FastAPI 中文文档；换分词器后要重新建索引。
MILVUS_ANALYZER=chinese

# ---- Agent 行为 ----
MAX_REWRITES=3
MAX_HISTORY_MESSAGES=20

# ---- 超时 ----
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
RETRIEVAL_TIMEOUT_SECONDS=20

# ---- 连接池 ----
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# ---- 其它 ----
CORS_ORIGINS=*
RATE_LIMIT=20/minute
MCP_ENABLED=true
EMBEDDING_MODEL_PATH=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOG_LEVEL=INFO
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=agentic-rag

# ---- Langfuse（本地自托管）----
# 先运行 scripts/langfuse_local.sh up；实际密钥由安装脚本写入 .env。
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_DOCKER_BASE_URL=http://host.docker.internal:3000
LANGFUSE_TRACING_ENVIRONMENT=development
