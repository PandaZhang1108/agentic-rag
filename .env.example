POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_URL=postgresql://postgres:replace-with-a-strong-password@localhost:5432/ragdb
MINIO_ACCESS_KEY_ID=replace-with-a-minio-access-key
MINIO_SECRET_ACCESS_KEY=replace-with-a-minio-secret-key
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
API_KEY=replace-with-a-random-api-key

CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVE_K=5
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=fastapi_docs_hybrid
MILVUS_SEARCH_MODE=dense
MILVUS_CANDIDATE_K=10
MILVUS_RRF_K=60
MILVUS_ANALYZER=chinese

MAX_REWRITES=3
MAX_HISTORY_MESSAGES=20

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
RETRIEVAL_TIMEOUT_SECONDS=20

DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

CORS_ORIGINS=*
RATE_LIMIT=20/minute
MCP_ENABLED=true
EMBEDDING_MODEL_PATH=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOG_LEVEL=INFO
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=agentic-rag
